# =============================================================
# Variáveis de ambiente da Nexa
# Copie para .env.local (dev) e cadastre as mesmas na Vercel
# (Settings → Environment Variables → Production).
# NUNCA commite valores reais — este arquivo é só o modelo.
# =============================================================

# ── Supabase (Settings → API no dashboard) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# service_role — SÓ servidor, bypassa RLS. Nunca prefixar com NEXT_PUBLIC_.
# Usada pelo cron de lembretes.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Resend (e-mail de lembrete) ──────────────────────────────
RESEND_API_KEY=re_xxx

# Remetente dos e-mails.
# Modo teste (sem domínio): "Nexa <onboarding@resend.dev>" — só entrega
# no e-mail da própria conta Resend.
# Produção: exige domínio verificado no Resend.
EMAIL_FROM=Nexa <onboarding@resend.dev>

# Opcional: logo no topo do e-mail (URL pública, ex: Supabase Storage).
# Sem isso, o cabeçalho mostra o texto "Nexa".
EMAIL_LOGO_URL=

# ── Cron (lembretes de agendamento) ──────────────────────────
# String aleatória forte (ex: openssl rand -base64 32).
# A Vercel envia como "Authorization: Bearer <CRON_SECRET>" automaticamente.
CRON_SECRET=

# ── Stripe (cobrança de assinaturas) ─────────────────────────
# Chave secreta — segredo de servidor, nunca prefixar com NEXT_PUBLIC_.
# Teste: sk_test_...  ·  Produção: sk_live_...
STRIPE_SECRET_KEY=

# Segredo do endpoint de webhook (whsec_...).
# Painel: Developers > Webhooks > seu endpoint > Signing secret.
# Local:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
