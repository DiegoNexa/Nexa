# =============================================================
# Variáveis de ambiente da Nexa
# Copie para .env.local (dev) e cadastre as mesmas na Vercel
# (Settings → Environment Variables → Production).
# NUNCA commite valores reais — este arquivo é só o modelo.
# =============================================================

# ── Supabase (Settings → API no dashboard) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# service_role — SÓ servidor, bypassa RLS. Nunca prefixar com NEXT_PUBLIC_.
# Usada pelo cron de lembretes.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Resend (e-mail de lembrete) ──────────────────────────────
RESEND_API_KEY=re_xxx

# Remetente dos e-mails.
# Modo teste (sem domínio): "Nexa <onboarding@resend.dev>" — só entrega
# no e-mail da própria conta Resend.
# Produção: exige domínio verificado no Resend.
EMAIL_FROM=Nexa <onboarding@resend.dev>

# Opcional: logo no topo do e-mail (URL pública, ex: Supabase Storage).
# Sem isso, o cabeçalho mostra o texto "Nexa".
EMAIL_LOGO_URL=

# ── Cron (lembretes de agendamento) ──────────────────────────
# String aleatória forte (ex: openssl rand -base64 32).
# A Vercel envia como "Authorization: Bearer <CRON_SECRET>" automaticamente.
CRON_SECRET=

# ── AbacatePay (cobrança de assinaturas) ─────────────────────
# Chave da API — segredo de servidor, nunca prefixar com NEXT_PUBLIC_.
ABACATEPAY_API_KEY=

# Segredo do webhook. Usado em DUAS validações:
#   1. query string:  /api/webhooks/abacatepay?secret=<valor>
#   2. chave do HMAC-SHA256 do header X-Webhook-Signature
# Gere igual ao CRON_SECRET (openssl rand -base64 32).
ABACATEPAY_WEBHOOK_SECRET=

# IDs dos produtos criados no painel do AbacatePay.
# Cada um precisa ter ciclo MONTHLY e o mesmo preço de lib/planos.ts
# (Solo R$49 · Profissional R$99 · Premium R$199).
ABACATEPAY_PRODUTO_SOLO=
ABACATEPAY_PRODUTO_PROFISSIONAL=
ABACATEPAY_PRODUTO_PREMIUM=

# MODO DE TESTE — cobrança única em vez de assinatura recorrente.
# Contas em modo de teste do AbacatePay não criam produto recorrente.
# Com "1", o checkout usa /billing/create e monta o produto a partir de
# lib/planos.ts — os ABACATEPAY_PRODUTO_* acima ficam dispensados.
# Não renova sozinho. Remova esta linha ao ir para produção.
ABACATEPAY_MODO_AVULSO=
